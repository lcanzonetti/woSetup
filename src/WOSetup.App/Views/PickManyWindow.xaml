<Window x:Class="WOSetup.App.Views.PickManyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="760" SizeToContent="Height" MaxHeight="800"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13">
    <DockPanel Margin="18">
        <TextBlock x:Name="IntroText" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,10" />
        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="Tick all" MinWidth="80" Padding="10,4" Margin="0,0,6,0" Click="OnAll" />
                <Button Content="Tick none" MinWidth="80" Padding="10,4" Click="OnNone" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OkButton" MinWidth="110" Padding="12,5" Margin="0,0,8,0" Click="OnOk" />
                <Button Content="Cancel" MinWidth="90" Padding="12,5" IsCancel="True" />
            </StackPanel>
        </DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="560">
            <ItemsControl x:Name="Items">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsChecked}" Margin="0,3">
                            <TextBlock TextWrapping="Wrap"><Run Text="{Binding Id, Mode=OneWay}" Foreground="#666" /><Run Text="  " /><Run Text="{Binding Text, Mode=OneWay}" /></TextBlock>
                        </CheckBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
