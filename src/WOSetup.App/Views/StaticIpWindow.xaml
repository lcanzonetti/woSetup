<Window x:Class="WOSetup.App.Views.StaticIpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Static IPv4 addresses" Width="900" SizeToContent="Height" MaxHeight="760"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock TextWrapping="Wrap" FontWeight="SemiBold"
                       Text="Tick the show adapters and enter their fixed addresses. All WATCHOUT nodes on one subnet." />
            <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,4,0,8"
                       Text="Gateway and DNS may stay empty on an isolated show network. Only one adapter should have a gateway. Unticked adapters are not changed." />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock x:Name="ErrorText" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Continue" MinWidth="110" Padding="12,5" Margin="0,0,8,0" Click="OnOk" />
                <Button Content="Cancel" MinWidth="90" Padding="12,5" IsCancel="True" />
            </StackPanel>
        </StackPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" /><ColumnDefinition Width="150" /><ColumnDefinition Width="70" />
                <ColumnDefinition Width="150" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Adapter" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="IPv4 address" FontWeight="SemiBold" />
            <TextBlock Grid.Column="2" Text="Prefix" FontWeight="SemiBold" />
            <TextBlock Grid.Column="3" Text="Gateway" FontWeight="SemiBold" />
            <TextBlock Grid.Column="4" Text="DNS (comma-separated)" FontWeight="SemiBold" />
        </Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420">
            <ItemsControl x:Name="Rows">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260" /><ColumnDefinition Width="150" /><ColumnDefinition Width="70" />
                                <ColumnDefinition Width="150" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding Use}" VerticalAlignment="Center" ToolTip="{Binding Current}">
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><LineBreak />
                                    <Run Text="{Binding Current, Mode=OneWay}" Foreground="#666" FontSize="11" />
                                </TextBlock>
                            </CheckBox>
                            <TextBox Grid.Column="1" Text="{Binding IPAddress, UpdateSourceTrigger=PropertyChanged}" Margin="4,0" VerticalAlignment="Center" />
                            <TextBox Grid.Column="2" Text="{Binding PrefixLength, UpdateSourceTrigger=PropertyChanged}" Margin="4,0" VerticalAlignment="Center" />
                            <TextBox Grid.Column="3" Text="{Binding Gateway, UpdateSourceTrigger=PropertyChanged}" Margin="4,0" VerticalAlignment="Center" />
                            <TextBox Grid.Column="4" Text="{Binding Dns, UpdateSourceTrigger=PropertyChanged}" Margin="4,0" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
