<Window x:Class="WOSetup.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WOSetup.App.ViewModels"
        Title="WATCHOUT Server Setup Wizard" Width="1320" Height="860" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13" Background="#FAFAFA">

    <Grid>
        <!-- ============================================================ START SCREEN -->
        <Grid Visibility="{Binding IsStartScreen, Converter={StaticResource BoolToVis}}">
            <Border Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4"
                    Width="620" VerticalAlignment="Center" Padding="28">
                <StackPanel>
                    <TextBlock Text="WATCHOUT Server Setup Wizard" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Margin="0,6,0,18" TextWrapping="Wrap" Foreground="#555"
                               Text="Prepares a WATCHOUT 6 or WATCHOUT 7 display server or production PC on Windows 11 Pro. It checks what is already in place, does the automatic steps after you confirm, and waits for you on the manual ones. Nothing is installed: after every restart, start this exe again from the USB stick and it continues where you left off." />

                    <TextBlock Text="Have these ready" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
                    <ItemsControl ItemsSource="{Binding HaveReady}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,3">
                                    <TextBlock Text="•" DockPanel.Dock="Left" Margin="0,0,6,0" Foreground="#555" />
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#555" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Profile" Style="{StaticResource SectionLabel}" />
                    <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding StartProfile}" Width="200" HorizontalAlignment="Left" />
                    <TextBlock Margin="0,4,0,0" Foreground="#666" TextWrapping="Wrap"
                               Text="WO7 = WATCHOUT 7, WO6 = WATCHOUT 6. Locked after the first script run (Start over to change it)." />

                    <TextBlock Text="Role" Style="{StaticResource SectionLabel}" />
                    <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding StartRole}" Width="200" HorizontalAlignment="Left" />
                    <TextBlock Margin="0,4,0,0" Foreground="#666" TextWrapping="Wrap"
                               Text="Display server, or Production PC (WATCHMAKER / Producer). Can be changed later in Options." />

                    <TextBlock Text="This machine" Style="{StaticResource SectionLabel}" />
                    <TextBlock Text="{Binding EnvironmentStatus}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding LgpoStatus}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    <TextBlock TextWrapping="Wrap" Margin="0,2,0,0">
                        <Run Text="State and logs: " /><Run Text="{Binding DataFolder, Mode=OneWay}" />
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button Content="Start and check this machine" Command="{Binding StartAndCheckCommand}" FontWeight="SemiBold" MinWidth="130" />
                        <Button Content="Start" Command="{Binding StartCommand}" MinWidth="110" />
                    </StackPanel>
                    <TextBlock Foreground="#666" TextWrapping="Wrap"
                               Text="&quot;Start and check&quot; runs every read-only check first (about a minute): use it on a machine that is already partly or fully prepared, also by hand. Steps found done are marked done." />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============================================================ WIZARD -->
        <DockPanel Visibility="{Binding IsStartScreen, Converter={StaticResource InverseBoolToVis}}">

            <!-- Header -->
            <Border DockPanel.Dock="Top" Background="#1F2A36" Padding="14,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Check this machine" Command="{Binding CheckMachineCommand}" Margin="0,0,6,0" FontWeight="SemiBold"
                                ToolTip="Runs every read-only check, marks what is already done and jumps to what is missing. Changes nothing." />
                        <Button Content="Fix what's missing" Command="{Binding FixMissingCommand}" Margin="0,0,6,0" FontWeight="SemiBold"
                                ToolTip="Walks every open step in checklist order: automatic steps after your confirmation, manual steps wait for you." />
                        <Button Content="Manual steps done…" Command="{Binding ConfirmManualStepsCommand}" Margin="0,0,6,0"
                                ToolTip="Tick manual steps without a check that were already done on this machine." />
                        <Button Content="Current step" Command="{Binding GoToCurrentCommand}" Margin="0,0,6,0" />
                        <Button Content="Options" Command="{Binding ShowOptionsCommand}" Margin="0,0,6,0" />
                        <Button Content="Logs folder" Command="{Binding OpenLogsCommand}" Margin="0,0,6,0" />
                        <Button Content="Support bundle" Command="{Binding ExportBundleCommand}" Margin="0,0,6,0" />
                        <Button Content="Start over" Command="{Binding StartOverCommand}" Margin="0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding HeaderText}" Foreground="White" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ProgressText}" Foreground="#B8C4D0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Banner -->
            <Border DockPanel.Dock="Top" Background="#FFF4CE" BorderBrush="#E8D48A" BorderThickness="0,0,0,1" Padding="14,8"
                    Visibility="{Binding HasBanner, Converter={StaticResource BoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Dismiss" Command="{Binding DismissBannerCommand}" Margin="0" />
                    <TextBlock Text="{Binding Banner}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" MinWidth="260" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ======================================================== LEFT RAIL -->
                <ListBox Grid.Column="0" ItemsSource="{Binding StepsView}" SelectedItem="{Binding SelectedStep}"
                         BorderThickness="0" Background="White"
                         VirtualizingPanel.IsVirtualizingWhenGrouping="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="6,10,0,3" Foreground="#1F2A36" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:StepItemViewModel}">
                            <DockPanel Margin="4,2">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding StatusGlyph}" Width="18" FontWeight="Bold"
                                           Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Id}" Width="78" Foreground="#666" />
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#E4E4E4" />

                <!-- ======================================================== OPTIONS -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="22,16"
                              Visibility="{Binding DataContext.IsOptionsVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                              DataContext="{Binding Options}">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                        <TextBlock FontSize="18" FontWeight="SemiBold">
                            <Run Text="Script options – " /><Run Text="{Binding ScriptName, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Foreground="#555" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Used by PostInstall and its audits. Each option is one script parameter; the defaults are the scripts' defaults. PreUpdate takes no options." />
                        <Border Background="#FFF4CE" Padding="10,6" Margin="0,10,0,0"
                                Visibility="{Binding PostInstallHasRun, Converter={StaticResource BoolToVis}}">
                            <TextBlock TextWrapping="Wrap"
                                       Text="PostInstall has already run on this machine. Changing an option and running it again does NOT undo what the earlier run applied (e.g. a firewall that was turned off stays off). Restore from the backups or set things back by hand." />
                        </Border>

                        <TextBlock Text="Role (-Role)" Style="{StaticResource SectionLabel}" />
                        <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding Role}" Width="200" HorizontalAlignment="Left" />

                        <TextBlock Text="Microsoft Defender (-DefenderMode)" Style="{StaticResource SectionLabel}" />
                        <ComboBox ItemsSource="{Binding DefenderModes}" SelectedItem="{Binding DefenderMode}" Width="200" HorizontalAlignment="Left" />
                        <TextBlock Foreground="#666" TextWrapping="Wrap" Margin="0,3,0,0"
                                   Text="Off: real-time protection off by policy (needs Tamper Protection off first). Exclusions: Defender stays on, WATCHOUT folders excluded. Skip: not touched." />

                        <TextBlock Text="Switches" Style="{StaticResource SectionLabel}" />
                        <CheckBox Content="-KeepFirewall: leave Windows Firewall on" IsChecked="{Binding KeepFirewall}" Margin="0,2" />
                        <CheckBox Content="-KeepUpdateService: keep the Windows Update services and tasks running" IsChecked="{Binding KeepUpdateService}" Margin="0,2" />
                        <StackPanel Visibility="{Binding IsWO6, Converter={StaticResource BoolToVis}}">
                            <CheckBox Content="-KeepServices: skip the guide's chapter 11 service changes entirely" IsChecked="{Binding KeepServices}" Margin="0,2" />
                            <CheckBox Content="-KeepAdapterBindings: do not unbind everything except IPv4 (needed for file shares / IPv6)" IsChecked="{Binding KeepAdapterBindings}" Margin="0,2" />
                            <CheckBox Content="-ForcePcieLinkSpeed: AMD GPUs only; can crash some AMD drivers at boot" IsChecked="{Binding ForcePcieLinkSpeed}" Margin="0,2" />
                        </StackPanel>

                        <TextBlock Text="Paths and values" Style="{StaticResource SectionLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="-WatchoutPath" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding WatchoutPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" ToolTip="Empty = detected by the script" />
                            <TextBlock Grid.Row="1" Text="-WorkingDirectory (WO7)" VerticalAlignment="Center" Visibility="{Binding IsWO7, Converter={StaticResource BoolToVis}}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" Visibility="{Binding IsWO7, Converter={StaticResource BoolToVis}}" ToolTip="Empty = the default .wo folder next to the install" />
                            <TextBlock Grid.Row="2" Text="-ShowsPath (WO6)" VerticalAlignment="Center" Visibility="{Binding IsWO6, Converter={StaticResource BoolToVis}}" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ShowsPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" Visibility="{Binding IsWO6, Converter={StaticResource BoolToVis}}" ToolTip="Empty = Shows inside the install folder" />
                            <TextBlock Grid.Row="3" Text="-StartDelay (WO6, s)" VerticalAlignment="Center" Visibility="{Binding IsWO6, Converter={StaticResource BoolToVis}}" />
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding StartDelay, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" Width="80" HorizontalAlignment="Left" Visibility="{Binding IsWO6, Converter={StaticResource BoolToVis}}" ToolTip="0-600, default 8" />
                            <TextBlock Grid.Row="4" Text="-KeepService (WO6)" VerticalAlignment="Center" Visibility="{Binding IsWO6, Converter={StaticResource BoolToVis}}" />
                            <DockPanel Grid.Row="4" Grid.Column="1" Margin="0,3" Visibility="{Binding IsWO6, Converter={StaticResource BoolToVis}}">
                                <Button DockPanel.Dock="Right" Content="Keep Remote Desktop" Command="{Binding KeepRemoteDesktopCommand}" Margin="8,0,0,0" />
                                <TextBox Text="{Binding KeepService, UpdateSourceTrigger=PropertyChanged}" ToolTip="Service names separated by commas, e.g. TermService, SessionEnv, UmRdpService" />
                            </DockPanel>
                        </Grid>

                        <TextBlock Text="Command PostInstall will run" Style="{StaticResource SectionLabel}" />
                        <TextBox Text="{Binding Preview, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" Background="#F3F3F3" Padding="6" />
                        <ItemsControl ItemsSource="{Binding Errors}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding}" Foreground="Firebrick" /></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="Save" Command="{Binding DataContext.SaveOptionsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Button Content="Close without saving" Command="{Binding DataContext.CloseOptionsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ======================================================== STEP DETAIL -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="22,16"
                              Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <StackPanel DataContext="{Binding SelectedStep}" MaxWidth="1000" HorizontalAlignment="Left">
                        <TextBlock Foreground="#666">
                            <Run Text="{Binding Id, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding SectionTitle, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,8" />

                        <WrapPanel>
                            <Border Style="{StaticResource Badge}"><TextBlock Text="{Binding KindText}" /></Border>
                            <Border Style="{StaticResource Badge}" Background="#E3F0FF" Visibility="{Binding NeedsInternet, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Needs internet" /></Border>
                            <Border Style="{StaticResource Badge}" Background="#E3F0FF" Visibility="{Binding MustBeOffline, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Network cable unplugged" /></Border>
                            <Border Style="{StaticResource Badge}" Background="#FDE7E9" Visibility="{Binding NeedsConfirmation, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Shows what changes and asks to type a confirmation" /></Border>
                            <Border Style="{StaticResource Badge}" Background="#FFF4CE" Visibility="{Binding IsUncertain, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="[Uncertain] item: not confirmed on real hardware" /></Border>
                        </WrapPanel>

                        <!-- Status -->
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding StatusGlyph}" FontWeight="Bold" FontSize="15" Margin="0,0,6,0"
                                       Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Foreground="#555" Margin="0,2,0,0"
                                   Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding CheckText}" TextWrapping="Wrap" Foreground="#555" Margin="0,2,0,0"
                                   Visibility="{Binding HasCheckText, Converter={StaticResource BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,4,0,0" Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding StringFormat=⚠ {0}}" TextWrapping="Wrap" Foreground="#B05A00" Margin="0,1" /></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- How / verification -->
                        <StackPanel Visibility="{Binding HasDetails, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="How / verification" Style="{StaticResource SectionLabel}" />
                            <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
                                     Background="Transparent" FontSize="13" />
                        </StackPanel>

                        <!-- Command preview for script steps -->
                        <StackPanel Visibility="{Binding DataContext.HasCommandPreview, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Command" Style="{StaticResource SectionLabel}" />
                            <TextBox Text="{Binding DataContext.CommandPreview, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                                     IsReadOnly="True" FontFamily="Consolas" TextWrapping="Wrap" Background="#F3F3F3" Padding="6" />
                        </StackPanel>

                        <!-- Actions -->
                        <TextBlock Text="Actions" Style="{StaticResource SectionLabel}" />
                        <TextBlock TextWrapping="Wrap" Foreground="#666" Margin="0,0,0,6" Visibility="{Binding IsManual, Converter={StaticResource BoolToVis}}"
                                   Text="Manual step: do it, then Mark done (the wizard runs the step's check first, if it has one)." />
                        <WrapPanel>
                            <Button Content="{Binding DoItText}" FontWeight="SemiBold" Visibility="{Binding CanDoIt, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DataContext.DoItCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Button Content="{Binding CheckButtonText}" Visibility="{Binding HasCheck, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DataContext.CheckNowCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Button Content="Options…" Visibility="{Binding IsOptionsStep, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DataContext.ShowOptionsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Button Content="Restart now" FontWeight="SemiBold" Visibility="{Binding IsRestart, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DataContext.RestartStepCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="now" />
                            <Button Content="I will restart myself" Visibility="{Binding IsRestart, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DataContext.RestartStepCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="later" />
                            <Button Content="Finish build" FontWeight="SemiBold" Visibility="{Binding IsFinish, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DataContext.FinishCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <ItemsControl ItemsSource="{Binding OpenTargets}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}" ContentStringFormat="Open {0}" CommandParameter="{Binding}"
                                                Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </WrapPanel>
                        <WrapPanel>
                            <Button Content="Mark done" Visibility="{Binding CanMarkDone, Converter={StaticResource BoolToVis}}"
                                    Command="{Binding DataContext.MarkDoneCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Button Content="Skip…" Command="{Binding DataContext.SkipCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Button Content="Not applicable…" Command="{Binding DataContext.NotApplicableCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Button Content="Reset" Command="{Binding DataContext.ResetStepCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </WrapPanel>

                        <!-- Run output -->
                        <StackPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Visibility="{Binding HasRunOutput, Converter={StaticResource BoolToVis}}">
                            <DockPanel Margin="0,14,0,4">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Stop" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
                                    <Button Content="Open run folder" Command="{Binding OpenRunFolderCommand}" Margin="0" />
                                </StackPanel>
                                <TextBlock Text="Last run" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#404040" />
                            </DockPanel>
                            <TextBlock Text="{Binding RunStatus}" TextWrapping="Wrap" Margin="0,0,0,4" />
                            <ListBox ItemsSource="{Binding LogLines}" Height="300" FontFamily="Consolas" FontSize="12"
                                     VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:LogLine}">
                                        <TextBlock Text="{Binding Text}" Foreground="{Binding Kind, Converter={StaticResource LineBrush}}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel Visibility="{Binding HasAuditRows, Converter={StaticResource BoolToVis}}">
                                <DockPanel Margin="0,12,0,4">
                                    <CheckBox DockPanel.Dock="Right" Content="Only items not set" IsChecked="{Binding ShowOnlyNotSet}" />
                                    <TextBlock Text="Audit result" FontWeight="SemiBold" Foreground="#404040" />
                                </DockPanel>
                                <DataGrid ItemsSource="{Binding VisibleAuditRows}" AutoGenerateColumns="False" IsReadOnly="True"
                                          HeadersVisibility="Column" Height="300" GridLinesVisibility="Horizontal" CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="State" Binding="{Binding State, Converter={StaticResource AuditText}}" Width="70" />
                                        <DataGridTextColumn Header="Section" Binding="{Binding Section}" Width="200" />
                                        <DataGridTextColumn Header="Item" Binding="{Binding Item}" Width="*" />
                                        <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="220" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
