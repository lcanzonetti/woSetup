<Window x:Class="WOSetup.App.Views.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="18">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,10" />
        <TextBox x:Name="AnswerBox" TextChanged="OnChanged" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="OkButton" Content="OK" MinWidth="90" Padding="12,5" Margin="0,0,8,0" IsDefault="True" IsEnabled="False" Click="OnOk" />
            <Button Content="Cancel" MinWidth="90" Padding="12,5" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
