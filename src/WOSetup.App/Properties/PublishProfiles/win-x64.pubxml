<?xml version="1.0" encoding="utf-8"?>
<!-- One portable exe: no installer, no .NET install needed on the target.
     dotnet publish src/WOSetup.App -c Release -p:PublishProfile=win-x64 -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WPF's native libraries are unpacked to the user's temp folder at first start. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- WPF does not support trimming. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishDir>..\..\publish\</PublishDir>
  </PropertyGroup>
</Project>
