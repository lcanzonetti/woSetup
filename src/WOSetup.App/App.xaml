<Application x:Class="WOSetup.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:WOSetup.App.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <v:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <v:LineKindToBrushConverter x:Key="LineBrush" />
        <v:StatusToBrushConverter x:Key="StatusBrush" />
        <v:AuditStateTextConverter x:Key="AuditText" />

        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="MinWidth" Value="90" />
        </Style>
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Background" Value="#EEF2F6" />
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,4" />
            <Setter Property="Foreground" Value="#404040" />
        </Style>
    </Application.Resources>
</Application>
