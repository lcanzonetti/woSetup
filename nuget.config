<?xml version="1.0" encoding="utf-8"?>
<!-- Package sources for this repository. Without this file, dotnet uses the
     sources configured on the build machine; on a PC where nuget.org is
     missing or disabled, restore fails with NU1100 ("Unable to resolve ...").
     Restoring needs internet access to api.nuget.org. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
